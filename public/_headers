# connect-src carries docs.google.com AND *.googleusercontent.com because a
# published-sheet CSV request is answered with a redirect to a
# doc-XX-XX-sheets.googleusercontent.com host. CSP checks every hop of a
# redirect chain, so allowing only the first one blocks the fetch at the
# redirect with an error that names the wrong host. Everything else stays
# 'self' — no other origin is contacted.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; worker-src 'self'; manifest-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://docs.google.com https://*.googleusercontent.com https://intake.stoatworks-labs.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The worker is the one file that must never be served stale: a cached sw.js
# is a cached update mechanism, and the app would stop being able to replace
# itself. Everything it caches is content-hashed and immutable, so nothing is
# lost by revalidating this one small file every time.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
