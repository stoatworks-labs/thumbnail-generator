{
  "name": "thumbnail-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bulk-generate labelled source thumbnails for Barco Eventmaster and Analog Way RCS2 \u2014 name, icon, colour and raster per source, out as a ZIP.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "serve:dist": "python3 scripts/serve-dist.py --dir dist --port 4331",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
